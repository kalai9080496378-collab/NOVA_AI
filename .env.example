# Application
APP_NAME="NOVA AI"
APP_ENV="development"
DEBUG=true
API_V1_PREFIX="/api/v1"

# Database (PostgreSQL)
# Async format for FastAPI: postgresql+asyncpg://user:pass@host:port/dbname
# Sync format for Alembic: postgresql+psycopg://user:pass@host:port/dbname
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/nova_ai"
DATABASE_URL_SYNC="postgresql+psycopg://postgres:postgres@localhost:5432/nova_ai"

# Redis & Celery
REDIS_URL="redis://localhost:6379/0"
CELERY_BROKER_URL="redis://localhost:6379/0"
CELERY_RESULT_BACKEND="redis://localhost:6379/0"

# Security & JWT
JWT_SECRET_KEY="change-me-to-a-very-secure-random-32-byte-secret"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Rate Limiting
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60

# Video Generation Provider (runapi / mock)
VIDEO_PROVIDER="runapi"
RUNAPI_API_KEY="your-runapi-key-here"

# LLM Provider (gemini / mock)
LLM_PROVIDER="gemini"
LLM_API_KEY="your-gemini-or-llm-api-key"

# TTS Provider (mock / gtts)
TTS_PROVIDER="mock"

# Storage
STORAGE_DIR="storage"

# Cost Protection Defaults
DEFAULT_MONTHLY_QUOTA=3
