# ==================================================
# NOVA AI ASSISTANT - CONFIGURATION TEMPLATE
# ==================================================
# Copy this file to .env and fill in your values if needed.
# By default, NOVA runs in Rule-Based Mode without requiring an API key.

# Environment Mode: development / production
NOVA_ENV=development

# Database path (defaults to data/nova.db inside the project root)
DATABASE_PATH=data/nova.db

# LLM Provider Configuration
# Options:
#   - gemini: Recommended for students (Free tier: 15 RPM, 1,500 RPD via Google AI Studio)
#   - openai: Paid pay-as-you-go per token (or compatible providers like Groq/Ollama)
#   - none:   Rule-Based local mode (No API key needed, zero network calls)
LLM_PROVIDER=gemini

# ==================================================
# 1. Google Gemini Configuration (Recommended Free Tier)
# Get your free key at: https://aistudio.google.com/
# ==================================================
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# ==================================================
# 2. OpenAI Configuration (Optional)
# Get your key at: https://platform.openai.com/
# ==================================================
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Application Settings
ASSISTANT_NAME=NOVA
LOG_LEVEL=INFO

# ==================================================
# 3. Voice Intelligence Settings (Phase 4)
# ==================================================
# Speech-to-Text Engine (Default: google - Free Google Web Speech API)
VOICE_STT_ENGINE=google

# Text-to-Speech Engine (Default: gtts - Free Google Text-to-Speech)
VOICE_TTS_ENGINE=gtts

# Auto-play synthesized voice responses in browser (true/false)
VOICE_AUTO_SPEAK=false

# ==================================================
# 4. Live Web Search & Deep Research Settings
# ==================================================
# Live search runs out-of-the-box with 100% free multi-engine search
# (Bing HTML, Google News RSS, Wikipedia API, ArXiv API, PyPI API).
# Zero API keys required!
# Optional external search providers (if you want to add external search APIs):
# TAVILY_API_KEY=
# SERPER_API_KEY=
